    {
      "parameters": {
        "jsCode": "\nconst now = new Date();\nconst cutoff = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst allLeads = $('Read Leads Tab').all().map(i => i.json);\nconst allSupport = $('Read Support Tab').all().map(i => i.json);\nconst allErrors = $('Read Errors Tab').all().map(i => i.json);\n\nconst recentLeads = allLeads.filter(r => r.created_at && new Date(r.created_at) >= cutoff);\nconst recentSupport = allSupport.filter(r => r.created_at && new Date(r.created_at) >= cutoff);\nconst recentErrors = allErrors.filter(r => r.created_at && new Date(r.created_at) >= cutoff);\n\n// Top 3 leads by priority\nconst priorityOrder = { HIGH: 0, MEDIUM: 1, LOW: 2 };\nconst top3 = recentLeads\n  .sort((a, b) => (priorityOrder[a.priority] ?? 3) - (priorityOrder[b.priority] ?? 3))\n  .slice(0, 3);\n\nconst unresolvedSupport = recentSupport.filter(r => !r.status || r.status === 'NEW');\n\nconst digestDate = now.toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Kolkata' });\n\nconst top3Lines = top3.length > 0\n  ? top3.map((l, i) => `${i+1}. [${l.priority || 'N/A'}] ${l.sender_email} — ${(l.subject || '').slice(0,60)}`).join('\\n')\n  : 'No leads today.';\n\nconst errorFlag = recentErrors.length > 0 ? `⚠️ ${recentErrors.length} error(s) logged — check errors tab` : '✅ No errors in last 24h';\n\nreturn [{\n  json: {\n    digest_date: digestDate,\n    new_leads_count: recentLeads.length,\n    top3_leads: top3Lines,\n    unresolved_support_count: unresolvedSupport.length,\n    total_errors_count: recentErrors.length,\n    error_flag: errorFlag,\n    slack_text: [\n      `📊 *Daily Digest — ${digestDate}*`,\n      ``,\n      `*New Leads (last 24h):* ${recentLeads.length}`,\n      `*Top 3 by Priority:*`,\n      top3Lines,\n      ``,\n      `*Unresolved Support Tickets:* ${unresolvedSupport.length}`,\n      ``,\n      errorFlag\n    ].join('\\n')\n  }\n}];\n"
      },
